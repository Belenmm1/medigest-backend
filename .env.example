# ═══════════════════════════════════════════════
# MediGest Pro — Variables de entorno
# Copiar a .env y completar con valores reales
# ═══════════════════════════════════════════════

# ── Servidor ──────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Base de datos PostgreSQL ───────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medigest_pro
DB_USER=medigest
DB_PASSWORD=medigest_secret_2024
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio_minimo_64_chars
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_tokens_minimo_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Seguridad ─────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_GLOBAL=200

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:3001

# ── Logs ──────────────────────────────────────
LOG_LEVEL=debug

# ── Notificaciones (Queue) ────────────────────
NOTIFICATION_QUEUE_CONCURRENCY=5

# URL pública del sistema (para links en notificaciones)
APP_URL=http://localhost:3000
